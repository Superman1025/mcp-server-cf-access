/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-server-cf-access",
  "main": "src/ableton-bridge.ts", "vpc_services": [{ "binding": "ABLETON_MCP", "service_id": "01a19de5-3fe3-7ab3-a9ca-05f8eb29bea6" }],
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  // The URL MCP clients connect to. Set it to your deployed URL, for example
  // https://<worker-name>.<your-subdomain>.workers.dev/mcp
  "vars": {
    "MCP_RESOURCE": "https://mcp-server-cf-access.nexusateprojects.workers.dev/mcp",
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "918bfedfc73449b9abedbe91289efcde"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  },
  "secrets": {
    "required": [
      "ACCESS_CLIENT_ID",
      "ACCESS_CLIENT_SECRET",
      "ACCESS_TOKEN_URL",
      "ACCESS_AUTHORIZATION_URL",
      "ACCESS_JWKS_URL",
      "COOKIE_ENCRYPTION_KEY"
    ]
  }
}
