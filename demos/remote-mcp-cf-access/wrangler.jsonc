/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcp-server-cf-access",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  // The URL MCP clients connect to. Set it to your deployed URL, for example
  // https://<worker-name>.<your-subdomain>.workers.dev/mcp
  "vars": {
    "MCP_RESOURCE": "http://localhost:8788/mcp",
  },
  "kv_namespaces": [
    {
      "binding": "oauth_kv",
      "id": "<918bfedfc73449b9abedbe91289efcde>"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  },
  "secrets": {
    "required": [
      "ACCESS_CLIENT_ID",
      "ACCESS_CLIENT_SECRET",
      "ACCESS_TOKEN_URL",
      "ACCESS_AUTHORIZATION_URL",
      "ACCESS_JWKS_URL",
      "COOKIE_ENCRYPTION_KEY"
    ]
  }
}
